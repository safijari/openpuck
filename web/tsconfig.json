{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"strict": true,
		"noEmit": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"types": ["node", "vite/client", "w3c-web-usb"],
		"resolveJsonModule": true,
		"allowJs": true,
		"checkJs": true,
		"paths": { "$lib/*": ["./src/lib/*"] }
	},
	"include": ["src/**/*.ts", "src/**/*.svelte", "vite.config.ts"]
}
